diff --git a/uboot-mtk-20250711/board/mediatek/common/nr3053_dualimage.c b/uboot-mtk-20250711/board/mediatek/common/nr3053_dualimage.c
new file mode 100644
index 000000000..575b09b76
--- /dev/null
+++ b/uboot-mtk-20250711/board/mediatek/common/nr3053_dualimage.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * KeenBOOT-compatible dual image boot for Viettel NR3053 running KeeneticOS.
+ *
+ * The Keenetic kernel (drivers/mtd/ndmpart_di.c, kernel-49 4.9.337-181-4)
+ * reads an 8-byte U-State record at half of the NMBM device and maps
+ * Firmware_1 or Firmware_2 from it.  The bootloader must load the kernel from
+ * the same slot, and /chosen/dualimage turns the kernel side on.
+ *
+ * Protocol, from ndm (libndmCorePack.so, Core::System::DualImage):
+ *  - firmware update (SwitchImage): active = 0, backup = running slot, fails = 0
+ *  - system ready, if running slot != active (CommitImage): active = running, fails = 0
+ * So active == 0 means "trial boot of the slot that is not backup".  ndm never
+ * clears fails for a committed image, so fails is counted only during a trial:
+ * each trial boot adds one; at DI_MAX_FAILS the bootloader goes back to backup.
+ */
+
+#include <command.h>
+#include <fdt_support.h>
+#include <linux/err.h>
+#include <linux/libfdt.h>
+#include <linux/mtd/mtd.h>
+#include <malloc.h>
+#include <mtd.h>
+#include <nr3053_dualimage.h>
+#include <vsprintf.h>
+
+#define DI_MTD_NAME		"nmbm0"
+#ifdef CONFIG_MTK_KEENETIC_DI_LAYOUT_32X6
+/*
+ * Viettel vAP-32X6V1, 128 MiB NAND, nmbm0 = 0x7800000 (keenetic-32x6 branch
+ * 5.1.8, kernel/402 + CONFIG_MTD_NDM_FLASH_SIZE_LIMIT 0x2800000):
+ * Firmware_1 0x700000-0x2700000, Config_1 0x2700000, U-State 0x3c00000,
+ * Firmware_2 0x4000000 (after Reserve, D-State and RF-EEPROM_res).
+ */
+#define DI_U_STATE_OFFSET	0x3c00000
+#define DI_FW1_OFFSET		0x700000
+#define DI_FW2_OFFSET		0x4000000
+#define DI_FIT_READ_SIZE	0x400000
+#define DI_FW_SLOT_SIZE		0x2000000
+#define DI_CFG1_OFFSET		0x2700000
+#else
+/* nmbm0 size / 2, as ndmpart_di.c computes it (logs/v9: U-State 0x7800000) */
+#define DI_U_STATE_OFFSET	0x7800000
+/* Firmware_1/_2 from sdk-patches/402 + ndmpart.c (kernel log v9+) */
+#define DI_FW1_OFFSET		0x600000
+#define DI_FW2_OFFSET		0x7d00000
+#define DI_FIT_READ_SIZE	0x400000
+/* CONFIG_MTD_NDM_FLASH_SIZE_LIMIT 0x2700000 (v27): Firmware_1 0x600000-0x2600000 */
+#define DI_FW_SLOT_SIZE		0x2000000
+/* Config_1 below the flash limit; Config_2 = U-State + Config_1 (ndmpart.c) */
+#define DI_CFG1_OFFSET		0x2600000
+#endif
+#define DI_CFG2_OFFSET		(DI_U_STATE_OFFSET + DI_CFG1_OFFSET)
+#define DI_CFG_SIZE		0x80000
+#define DI_LOAD_ADDR		0x46000000
+
+#define DI_MAGIC		0x55535441	/* "USTA" */
+/* /proc/dual_image/boot_fails accepts 0..2: two trial boots, then fallback */
+#define DI_MAX_FAILS		2
+#define DI_VERSION		1
+
+struct di_u_state {
+	__be32 magic;
+	u8 version;
+	u8 boot_active;
+	u8 boot_backup;
+	u8 boot_fails;
+} __packed;
+
+static struct mtd_info *di_open(void)
+{
+	struct mtd_info *mtd;
+	u64 half;
+
+	mtd_probe_devices();
+	mtd = get_mtd_device_nm(DI_MTD_NAME);
+	if (IS_ERR_OR_NULL(mtd))
+		return NULL;
+
+	half = (mtd->size >> 1) & ~((u64)mtd->erasesize - 1);
+	if (half != DI_U_STATE_OFFSET || mtd->size < DI_FW2_OFFSET + DI_FIT_READ_SIZE) {
+		printf("DualImage: %s size 0x%llx does not match the Keenetic layout\n",
+		       DI_MTD_NAME, (unsigned long long)mtd->size);
+		put_mtd_device(mtd);
+		return NULL;
+	}
+
+	return mtd;
+}
+
+/* Same bounds as /proc/dual_image setters in ndmpart_di.c */
+static bool di_read(struct mtd_info *mtd, struct di_u_state *st)
+{
+	size_t retlen = 0;
+
+	if (mtd_read(mtd, DI_U_STATE_OFFSET, sizeof(*st), &retlen, (u8 *)st) < 0 ||
+	    retlen != sizeof(*st))
+		return false;
+
+	return be32_to_cpu(st->magic) == DI_MAGIC && st->version == DI_VERSION &&
+	       st->boot_active <= 2 && st->boot_backup >= 1 &&
+	       st->boot_backup <= 2 && st->boot_fails <= 2;
+}
+
+/* Copy of the boot_current rule in ndmpart_di_init() */
+static int di_current(const struct di_u_state *st)
+{
+	if (st->boot_active)
+		return st->boot_active == 1 ? 1 : 2;
+
+	return st->boot_backup == 1 ? 2 : 1;
+}
+
+static bool di_slot_has_fit(struct mtd_info *mtd, int slot)
+{
+	u8 hdr[64];
+	size_t retlen = 0;
+	loff_t off = slot == 1 ? DI_FW1_OFFSET : DI_FW2_OFFSET;
+
+	if (mtd_read(mtd, off, sizeof(hdr), &retlen, hdr) < 0 ||
+	    retlen != sizeof(hdr))
+		return false;
+
+	return fdt_magic(hdr) == FDT_MAGIC;
+}
+
+/* Like __ndmpart_di_commit(): keep the rest of the page, rewrite one page */
+static int di_write(struct mtd_info *mtd, const struct di_u_state *st)
+{
+	struct erase_info erase = {};
+	struct di_u_state check;
+	size_t retlen = 0;
+	u8 *page;
+	int ret;
+
+	page = malloc(mtd->writesize);
+	if (!page)
+		return -ENOMEM;
+
+	ret = mtd_read(mtd, DI_U_STATE_OFFSET, mtd->writesize, &retlen, page);
+	if (ret < 0 || retlen != mtd->writesize)
+		goto fail;
+	memcpy(page, st, sizeof(*st));
+
+	erase.mtd = mtd;
+	erase.addr = DI_U_STATE_OFFSET;
+	erase.len = mtd->erasesize;
+	ret = mtd_erase(mtd, &erase);
+	if (ret)
+		goto fail;
+	ret = mtd_write(mtd, DI_U_STATE_OFFSET, mtd->writesize, &retlen, page);
+	if (ret < 0 || retlen != mtd->writesize || !di_read(mtd, &check) ||
+	    memcmp(&check, st, sizeof(check)))
+		goto fail;
+
+	free(page);
+	return 0;
+
+fail:
+	free(page);
+	printf("DualImage: U-State write failed (%d)\n", ret);
+	return ret < 0 ? ret : -EIO;
+}
+
+int nr3053_di_reset_after_upgrade(void)
+{
+	static const struct di_u_state def = {
+		.magic = cpu_to_be32(DI_MAGIC), .version = DI_VERSION,
+		.boot_active = 1, .boot_backup = 1, .boot_fails = 0,
+	};
+	struct di_u_state st;
+	struct mtd_info *mtd;
+	int ret = 0;
+
+	mtd = di_open();
+	if (!mtd)
+		return -ENODEV;
+
+	/* No valid record: not a Keenetic layout yet, never write here. */
+	if (di_read(mtd, &st) && memcmp(&st, &def, sizeof(def))) {
+		ret = di_write(mtd, &def);
+		if (!ret)
+			printf("DualImage: U-State reset to Firmware_1 after upgrade\n");
+	}
+
+	put_mtd_device(mtd);
+	return ret;
+}
+
+/*
+ * ndm keeps one config per slot and copies it only on its own SwitchImage, so a
+ * failsafe upgrade must carry the running config over, or the new slot boots
+ * with defaults (Config_2 is empty until then).  An empty source is not copied.
+ */
+static int di_copy_config(struct mtd_info *mtd, int from, int to)
+{
+	loff_t src = from == 1 ? DI_CFG1_OFFSET : DI_CFG2_OFFSET;
+	loff_t dst = to == 1 ? DI_CFG1_OFFSET : DI_CFG2_OFFSET;
+	struct erase_info erase = {};
+	size_t retlen = 0, i;
+	u8 *buf;
+	int ret;
+
+	buf = malloc(DI_CFG_SIZE);
+	if (!buf)
+		return -ENOMEM;
+	ret = mtd_read(mtd, src, DI_CFG_SIZE, &retlen, buf);
+	if (ret < 0 || retlen != DI_CFG_SIZE)
+		goto fail;
+	for (i = 0; i < DI_CFG_SIZE && buf[i] == 0xff; i++)
+		;
+	if (i == DI_CFG_SIZE) {
+		printf("DualImage: Config_%d is empty, not copied\n", from);
+		free(buf);
+		return 0;
+	}
+
+	erase.mtd = mtd;
+	erase.addr = dst;
+	erase.len = DI_CFG_SIZE;
+	ret = mtd_erase(mtd, &erase);
+	if (ret)
+		goto fail;
+	ret = mtd_write(mtd, dst, DI_CFG_SIZE, &retlen, buf);
+	if (ret < 0 || retlen != DI_CFG_SIZE)
+		goto fail;
+
+	printf("DualImage: Config_%d copied to Config_%d\n", from, to);
+	free(buf);
+	return 0;
+
+fail:
+	free(buf);
+	return ret < 0 ? ret : -EIO;
+}
+
+/*
+ * Failsafe upgrade into the slot that is not known-good, then ask for a trial
+ * boot exactly like ndm's SwitchImage (active = 0, backup = known-good slot).
+ * If the new image does not reach SystemReady (ndm CommitImage) within
+ * DI_MAX_FAILS boots, di_select() goes back to the old slot.
+ * Returns -ENODEV when the layout does not match, so the caller can fall back.
+ */
+int nr3053_di_write_fw(const void *data, size_t size)
+{
+	struct di_u_state st;
+	struct erase_info erase = {};
+	struct mtd_info *mtd;
+	size_t retlen = 0, full;
+	loff_t off;
+	u8 *tail = NULL;
+	int good, target, ret;
+
+	mtd = di_open();
+	if (!mtd)
+		return -ENODEV;
+
+	if (size < sizeof(u32) * 2 || fdt_magic(data) != FDT_MAGIC) {
+		printf("DualImage: upload is not a FIT image\n");
+		ret = -EINVAL;
+		goto out;
+	}
+	if (size > DI_FW_SLOT_SIZE) {
+		printf("DualImage: image 0x%zx exceeds slot 0x%x\n", size,
+		       DI_FW_SLOT_SIZE);
+		ret = -EFBIG;
+		goto out;
+	}
+
+	/* Known-good slot: committed one, or backup while a trial is pending */
+	if (di_read(mtd, &st))
+		good = st.boot_active ? st.boot_active : st.boot_backup;
+	else
+		good = 1;
+	target = 3 - good;
+	off = target == 1 ? DI_FW1_OFFSET : DI_FW2_OFFSET;
+	printf("DualImage: writing Firmware_%d (0x%llx), keeping Firmware_%d\n",
+	       target, (unsigned long long)off, good);
+
+	erase.mtd = mtd;
+	erase.addr = off;
+	erase.len = DI_FW_SLOT_SIZE;
+	ret = mtd_erase(mtd, &erase);
+	if (ret)
+		goto out;
+
+	full = size & ~((size_t)mtd->writesize - 1);
+	if (full) {
+		ret = mtd_write(mtd, off, full, &retlen, data);
+		if (ret < 0 || retlen != full)
+			goto out_io;
+	}
+	if (size > full) {
+		tail = malloc(mtd->writesize);
+		if (!tail) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		memset(tail, 0xff, mtd->writesize);
+		memcpy(tail, (const u8 *)data + full, size - full);
+		ret = mtd_write(mtd, off + full, mtd->writesize, &retlen, tail);
+		if (ret < 0 || retlen != mtd->writesize)
+			goto out_io;
+	}
+
+	ret = di_copy_config(mtd, good, target);
+	if (ret)
+		goto out;
+
+	st.magic = cpu_to_be32(DI_MAGIC);
+	st.version = DI_VERSION;
+	st.boot_active = 0;
+	st.boot_backup = good;
+	st.boot_fails = 0;
+	ret = di_write(mtd, &st);
+	if (!ret)
+		printf("DualImage: trial boot of Firmware_%d armed, fallback Firmware_%d\n",
+		       target, good);
+	goto out;
+
+out_io:
+	if (!ret)
+		ret = -EIO;
+out:
+	if (ret)
+		printf("DualImage: firmware write failed (%d)\n", ret);
+	free(tail);
+	put_mtd_device(mtd);
+	return ret;
+}
+
+/*
+ * Pick the slot to boot and record a trial boot.  Returns 1 or 2.
+ * With dry_run nothing is written (for "print").
+ */
+static int di_select(struct mtd_info *mtd, bool dry_run)
+{
+	struct di_u_state st;
+	int slot;
+
+	if (!di_read(mtd, &st)) {
+		printf("DualImage: no valid U-State -> Firmware_1\n");
+		return 1;
+	}
+
+	printf("DualImage: active %u, backup %u, fails %u\n",
+	       st.boot_active, st.boot_backup, st.boot_fails);
+
+	slot = di_current(&st);
+
+	if (st.boot_active) {
+		if (di_slot_has_fit(mtd, slot) || !di_slot_has_fit(mtd, 3 - slot))
+			return slot;
+		/* The kernel maps the slot from U-State, so it must follow */
+		printf("DualImage: Firmware_%d has no FIT, using Firmware_%d\n",
+		       slot, 3 - slot);
+		slot = 3 - slot;
+		st.boot_active = slot;
+		st.boot_fails = 0;
+	} else if (st.boot_fails >= DI_MAX_FAILS || !di_slot_has_fit(mtd, slot)) {
+		/* Trial boot of the new image (active == 0) failed */
+		printf("DualImage: Firmware_%d failed %u trial boot(s), back to Firmware_%u\n",
+		       slot, st.boot_fails, st.boot_backup);
+		st.boot_active = st.boot_backup;
+		st.boot_fails = 0;
+		slot = st.boot_backup;
+	} else {
+		st.boot_fails++;
+		printf("DualImage: trial boot %u/%u of Firmware_%d\n",
+		       st.boot_fails, DI_MAX_FAILS, slot);
+	}
+
+	if (!dry_run && di_write(mtd, &st))
+		printf("DualImage: continuing without saving U-State\n");
+
+	return slot;
+}
+
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	int chosen = fdt_find_or_add_subnode(blob, 0, "chosen");
+	u8 one = 1;
+
+	if (chosen < 0)
+		return chosen;
+
+	/* 1-byte property: the kernel reads it with of_property_read_u8() */
+	return fdt_setprop(blob, chosen, "dualimage", &one, sizeof(one));
+}
+
+static int do_nr3053_di(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	struct mtd_info *mtd;
+	char cmd[128];
+	int slot;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	if (!strcmp(argv[1], "reset"))
+		return nr3053_di_reset_after_upgrade() ? CMD_RET_FAILURE :
+							 CMD_RET_SUCCESS;
+
+	if (strcmp(argv[1], "print") && strcmp(argv[1], "boot"))
+		return CMD_RET_USAGE;
+
+	mtd = di_open();
+	if (!mtd)
+		return CMD_RET_FAILURE;
+
+	slot = di_select(mtd, !strcmp(argv[1], "print"));
+	put_mtd_device(mtd);
+	printf("DualImage: -> Firmware_%d\n", slot);
+
+	if (!strcmp(argv[1], "print"))
+		return CMD_RET_SUCCESS;
+
+	snprintf(cmd, sizeof(cmd),
+		 "mtd read %s 0x%x 0x%x 0x%x && bootm 0x%x#config@1",
+		 DI_MTD_NAME, DI_LOAD_ADDR,
+		 slot == 1 ? DI_FW1_OFFSET : DI_FW2_OFFSET, DI_FIT_READ_SIZE,
+		 DI_LOAD_ADDR);
+
+	return run_command(cmd, 0) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(nr3053_di, 2, 0, do_nr3053_di,
+	   "KeeneticOS dual image (U-State) on NR3053",
+	   "print - show U-State and the slot that would boot (no write)\n"
+	   "nr3053_di boot  - boot the slot the Keenetic kernel will map\n"
+	   "nr3053_di reset - set U-State to Firmware_1 (only if a record exists)"
+);
