+/*
+ * U-Boot writes U-Config as a 128 KiB env block, but KeeneticOS ndm rewrites the
+ * active slot as a 16 KiB env (CRC over 0x4000 - 4, adds lock=yes, values unchanged).
+ * Accept both, otherwise every boot "repairs" the active slot that ndm rewrote.
+ */
+#define NR_NDM_ENV_SIZE			0x004000
+
 static bool nr_env_block_crc_ok(const u8 block[NR_ENV_BLOCK_SIZE])
 {
-	return get_unaligned_le32(block) ==
-		crc32(0, block + sizeof(u32), NR_ENV_DATA_SIZE);
+	u32 stored = get_unaligned_le32(block);
+
+	return stored == crc32(0, block + sizeof(u32), NR_ENV_DATA_SIZE) ||
+	       stored == crc32(0, block + sizeof(u32),
+			       NR_NDM_ENV_SIZE - sizeof(u32));
 }
 
