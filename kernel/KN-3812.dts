/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include <mediatek/mt7981.dtsi>
/*
 * KeeneticOS (KN-3812 build) on the Viettel vAP-32X6V1: KN-3812 DTS with
 * 256 MiB RAM, no NMBM (the NAND is shared with OpenWrt's UBI), no USB,
 * /chosen/dualimage for ndm, ramoops for debugging, and the 32x6 GPIOs
 * (MT7531 reset, LED pins phr.ko does not drive) put in a safe state.
 */
/ {
	model = "Viettel vAP-32X6V1";
	compatible = "keenetic,kn-3812", "mediatek,mt7981";

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 panic=5 earlycon=uart8250,mmio32,0x11002000";
		/* KeenBOOT adds this; without it ndmpart creates no
		 * /proc/dual_image and ndm exits. Read with of_property_read_u8,
		 * so it must be one byte. */
		dualimage = [01];
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x10000000>;
	};

	/* Console log kept in RAM across a warm reboot (U-Boot relocates to
	 * the top of RAM, so this stays below it) */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@4e000000 {
			compatible = "ramoops";
			reg = <0 0x4e000000 0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			ecc-size = <0>;
		};
	};

	gsw: gsw-sgmii0 {
		compatible = "mediatek,mt7531";
		#address-cells = <1>;
		#size-cells = <0>;
		mediatek,ethsys = <&ethsys>;
	};

	gbe0: gbe-gmii1 {
		compatible = "ethernet-phy-id03a2.9461";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		nvmem-cells = <&phy_calibration>;
		nvmem-cell-names = "phy-cal-data";
	};

	reg_fixed_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&gsw {
	interrupt-parent = <&pio>;
	interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;
	status = "okay";
};

&eth {
	mediatek,gsw = <&gsw>;
	mediatek,phy = <&gbe0>;
	status = "okay";
};

&hnat {
	eth-max-gmac = <2>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&wbsys {
	status = "okay";
};

&wed {
	wdma_rx_ring_depth = <1024>;
	wdma_tx_ring_depth = <1024>;
	status = "okay";
};

&wed_pcie {
	status = "disabled";
};

&pio {
	/* The 32x6 has no external pull-up on the buttons (WPS/mesh GPIO 0,
	 * RESET GPIO 1, both active-low): without the internal one a cold boot
	 * can read RESET as pressed, and phr.ko then makes ndm reset the
	 * configuration to factory defaults and reboot, every boot. Applied when
	 * the pinctrl driver probes, before phr.ko loads. */
	pinctrl-names = "default";
	pinctrl-0 = <&button_pins>;

	button_pins: button-pins {
		conf {
			pins = "GPIO_WPS", "GPIO_RESET";
			mediatek,pull-up-adv = <3>;	/* pull-up 75k */
		};
	};

	/* MT7531 reset (high = running); phr.ko also drives it high (binpatch) */
	mt7531-reset-hog {
		gpio-hog;
		gpios = <39 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "mt7531-reset";
	};

	/* RGB status LED: phr.ko drives green (GPIO 8) and red (GPIO 5) as the
	 * KN-3812 green/orange LED; start with red and blue off */
	led-red-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "led-red";
	};

	led-blue-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "led-blue";
	};

	/* GPIO 9 (lit when high) and GPIO 34 (lit when low) also light green */
	led-green2-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "led-green2";
	};

	led-green3-hog {
		gpio-hog;
		gpios = <34 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "led-green3";
	};

	spi0_flash_pins: spi0-pins-16-to-21 {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <3>;	/* pull-up 75k */
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-down-adv = <3>;	/* pull-down 75k */
		};
	};
};
